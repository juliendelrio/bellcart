{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plan",
  "description": "The plan for one scan root.",
  "type": "object",
  "properties": {
    "applications": {
      "description": "Applications found on the profile, by recipe id.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Application"
      }
    },
    "root": {
      "description": "The scanned root, as given by the user.",
      "type": "string"
    },
    "split": {
      "description": "The budget the review mass was cut with, so a cut can be reproduced.",
      "anyOf": [
        {
          "$ref": "#/$defs/SplitBudget"
        },
        {
          "type": "null"
        }
      ]
    },
    "totals": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Totals"
      }
    },
    "tree": {
      "$ref": "#/$defs/PlanNode"
    },
    "version": {
      "description": "Format version of this document.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "version",
    "root",
    "totals",
    "tree"
  ],
  "$defs": {
    "Application": {
      "description": "An application whose recipe detected it on the profile.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "recipe": {
          "description": "The recipe id.",
          "type": "string"
        }
      },
      "required": [
        "recipe",
        "name"
      ]
    },
    "Decision": {
      "description": "Where a folder goes.",
      "oneOf": [
        {
          "description": "Needed on the new PC.",
          "type": "string",
          "const": "migrate"
        },
        {
          "description": "Worth keeping, not needed day to day: goes to cold storage.",
          "type": "string",
          "const": "archive"
        },
        {
          "description": "Regenerable or obsolete: stays behind.",
          "type": "string",
          "const": "leave"
        },
        {
          "description": "Nothing settled it yet: an arbiter or the user must decide.",
          "type": "string",
          "const": "review"
        }
      ]
    },
    "PlanNode": {
      "description": "A folder and the decision that applies to everything under it, except\nthe sub-folders listed in `overrides`. A node settled by a recipe may\nalso be a single file (`.gitconfig`).\n\nThis mirrors how copy tools work: \"take this folder, but not those\".",
      "type": "object",
      "properties": {
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanNode"
          }
        },
        "path": {
          "description": "Path relative to the scan root, with `/` separators. Empty for the root.",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "stats": {
          "description": "Files covered by this node, excluding `overrides`.",
          "$ref": "#/$defs/Stats"
        },
        "unit": {
          "description": "Set on `review` nodes that are one unit of decision: why the cut of\nthe review mass stopped here. `stats` are then what there is to judge.",
          "anyOf": [
            {
              "$ref": "#/$defs/UnitReason"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path",
        "decision",
        "source",
        "stats"
      ]
    },
    "Source": {
      "description": "Who took a decision.",
      "oneOf": [
        {
          "description": "A rule from a pack. `reason` is a translation key (`reason-<key>`).",
          "type": "object",
          "properties": {
            "by": {
              "type": "string",
              "const": "rule"
            },
            "reason": {
              "type": "string"
            },
            "rule": {
              "type": "string"
            }
          },
          "required": [
            "by",
            "rule",
            "reason"
          ]
        },
        {
          "description": "A `copy` or `skip` step in the recipe of an application found on the\nprofile. `recipe` is its id, listed in [`Plan::applications`].",
          "type": "object",
          "properties": {
            "by": {
              "type": "string",
              "const": "recipe"
            },
            "recipe": {
              "type": "string"
            }
          },
          "required": [
            "by",
            "recipe"
          ]
        },
        {
          "description": "An arbiter's answers about a review unit, combined under the\nprudence rules. `opinion` is what it suggested: on a `review` node,\na `leave` waiting for the user to confirm.",
          "type": "object",
          "properties": {
            "backend": {
              "type": "string"
            },
            "by": {
              "type": "string",
              "const": "arbiter"
            },
            "opinion": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Decision"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "by",
            "backend"
          ]
        },
        {
          "description": "The user decided, in the review interface. It overrides whatever\ndecided before.",
          "type": "object",
          "properties": {
            "by": {
              "type": "string",
              "const": "user"
            }
          },
          "required": [
            "by"
          ]
        },
        {
          "description": "Inherited default: no rule matched.",
          "type": "object",
          "properties": {
            "by": {
              "type": "string",
              "const": "default"
            }
          },
          "required": [
            "by"
          ]
        }
      ]
    },
    "SplitBudget": {
      "description": "How far the review mass is cut. Sizes are in bytes, depth counts\nfolders below the scan root.",
      "type": "object",
      "properties": {
        "homogeneous_percent": {
          "description": "A folder where one extension holds at least this share of the bytes\nis one unit, provided the other bytes are at most `split_above`.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "max_depth": {
          "description": "Folders at this depth are not cut further.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "min_unit": {
          "description": "A sub-folder smaller than this stays in its parent's rest.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "split_above": {
          "description": "A folder at most this big is one unit.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "split_above",
        "min_unit",
        "homogeneous_percent",
        "max_depth"
      ]
    },
    "Stats": {
      "description": "Size figures for the files a node covers.",
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "extensions": {
          "description": "Bytes per lowercase extension (`\"\"` for files without one).",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "files": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "newest": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "oldest": {
          "description": "Oldest and newest modification, seconds since the Unix epoch.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "unreadable": {
          "description": "Entries that could not be read (access denied, for instance).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "bytes",
        "files"
      ]
    },
    "Totals": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "files": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "bytes",
        "files"
      ]
    },
    "UnitReason": {
      "description": "Why a review folder is judged as one unit instead of being cut further.",
      "oneOf": [
        {
          "description": "Small enough to judge as a whole.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "small"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "Mostly files of one extension, and the rest is small.",
          "type": "object",
          "properties": {
            "extension": {
              "type": "string"
            },
            "percent": {
              "description": "Share of the bytes, rounded down.",
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "reason": {
              "type": "string",
              "const": "homogeneous"
            }
          },
          "required": [
            "reason",
            "extension",
            "percent"
          ]
        },
        {
          "description": "Reached the depth limit of the cut.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "depth-limit"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "No sub-folder big enough to be judged on its own.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "leaf"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "What is left directly in a folder that was cut: its own files and\nits sub-folders too small to stand alone.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "rest"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "A `review` rule recognised the folder (a synced folder, say): it is\njudged whole, whatever its size, and never folded into another unit.",
          "type": "object",
          "properties": {
            "key": {
              "description": "Translation key of the reason, as in `Source::Rule`.",
              "type": "string"
            },
            "reason": {
              "type": "string",
              "const": "rule"
            },
            "rule": {
              "type": "string"
            }
          },
          "required": [
            "reason",
            "rule",
            "key"
          ]
        }
      ]
    }
  }
}
